      .setHelpText('В каждом вопросе выберите один вариант ответа.');

  // ---------- вопросы ----------
  for (var i = 0; i < QUESTIONS.length; i++) {
    var item = QUESTIONS[i];
    var mc = form.addMultipleChoiceItem();

    mc.setTitle((i + 1) + '. ' + item.q);
    mc.setRequired(true);
    mc.setPoints(1);

    var choices = [];
    for (var j = 0; j < item.a.length; j++) {
      choices.push(mc.createChoice(item.a[j], j === item.ok));
    }
    mc.setChoices(choices);
  }

  Logger.log('ГОТОВО: ' + TITLE);
