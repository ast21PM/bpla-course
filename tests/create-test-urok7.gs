  // иначе форма будет требовать входа в аккаунт Google
  copy.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);

  var form = FormApp.openById(copy.getId());

  form.setTitle(TITLE);
  form.setDescription(
