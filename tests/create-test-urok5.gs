    {
      q: "Что называется каналом?",
      a: [
          "Частота, на которой работает связь",
          "Одна независимая величина, которую пульт передаёт на борт",
          "Провод от приёмника к контроллеру",
          "Режим полёта"
      ],
      ok: 1
    },
    {
      q: "Сколько основных каналов дают два стика пульта?",
      a: [
          "Два",
          "Три",
          "Четыре",
          "Восемь"
      ],
      ok: 2
    },
    {
      q: "Какой стик не возвращается в центр сам?",
      a: [
          "Стик крена",
          "Стик тангажа",
          "Все стики возвращаются",
          "Стик газа"
      ],
      ok: 3
    },
    {
      q: "Что находится на левом стике в раскладке Mode 2?",
      a: [
          "Газ и рыскание",
          "Газ и крен",
          "Тангаж и рыскание",
          "Тангаж и крен"
      ],
      ok: 0
    },
    {
      q: "Какой диапазон лучше проходит сквозь препятствия и даёт большую дальность?",
      a: [
          "2,4 ГГц",
          "868–915 МГц",
          "5,8 ГГц",
          "Диапазон не влияет"
      ],
      ok: 1
    },
    {
      q: "Что такое протокол связи?",
      a: [
          "Настройка мощности",
          "Название модели пульта",
          "Язык, на котором передатчик и приёмник разговаривают: как упакованы данные и как часто уходят пакеты",
          "Провод между приёмником и контроллером"
      ],
      ok: 2
    },
    {
      q: "Что даёт перестройка по частотам во время связи?",
      a: [
          "Экономит заряд пульта",
          "Увеличивает число каналов",
          "Увеличивает мощность передатчика",
          "При помехе теряется один пакет, а следующий уходит на другой частоте, и связь не рвётся"
      ],
      ok: 3
    },
    {
      q: "Зачем выполняется привязка?",
      a: [
          "Чтобы аппарат слушался только своего пульта",
          "Чтобы включить телеметрию",
          "Чтобы снизить задержку",
          "Чтобы увеличить дальность"
      ],
      ok: 0
    },
    {
      q: "По какому каналу передаётся телеметрия?",
      a: [
          "По видеоканалу",
          "По каналу управления",
          "По отдельному третьему каналу",
          "По проводу"
      ],
      ok: 1
    },
    {
      q: "Что такое failsafe?",
      a: [
          "Проверка привязки",
          "Режим экономии заряда",
          "Заранее заданное поведение аппарата при потере связи",
          "Защита от перегрева"
      ],
      ok: 2
    },
    {
      q: "Как проверяют поведение при потере связи?",
      a: [
          "Только по инструкции",
          "Проверка не требуется",
          "В полёте на большой высоте",
          "На земле, со снятыми винтами"
      ],
      ok: 3
    },
    {
      q: "В каком направлении штыревая антенна излучает слабее всего?",
      a: [
          "Вдоль собственной оси, «в торец»",
          "Вниз",
          "Излучает одинаково во все стороны",
          "Вбок"
      ],
      ok: 0
    },
    {
      q: "Что такое CRSF?",
      a: [
          "Название радиосистемы",
          "Протокол, по которому приёмник разговаривает с полётным контроллером по проводу",
          "Диапазон частот",
          "Марка пульта"
      ],
      ok: 1
    },
    {
      q: "Чем ExpressLRS принципиально отличается от TBS Crossfire?",
      a: [
          "Его развивает одна компания",
          "Работает только на 2,4 ГГц",
          "У него открытый исходный код, оборудование выпускают десятки производителей",
          "У него выше цена комплекта"
      ],
      ok: 2
    }
  ];

  // ---------- копия настроенной формы ----------
  var copy = DriveApp.getFileById(TEMPLATE_ID).makeCopy(TITLE);

  // копия создаётся закрытой — открываем доступ по ссылке,
  // иначе форма будет требовать входа в аккаунт Google
  copy.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);

  var form = FormApp.openById(copy.getId());

  form.setTitle(TITLE);
  form.setDescription(
    'Учебное пособие «Внутреннее устройство БПЛА».\n\n' +
    '15 вопросов, в каждом один правильный ответ. Максимум — 15 баллов, ' +
    'рекомендуемый результат — не менее 12.\n\n' +
    'Укажите фамилию, имя и группу: эти данные сохраняются вместе с ответами.'
  );

  // ---------- очистка содержимого копии ----------
  var items = form.getItems();
  for (var k = items.length - 1; k >= 0; k--) {
    form.deleteItem(items[k]);
  }

  // ---------- поля с данными учащегося ----------
  form.addTextItem().setTitle('Фамилия').setRequired(true);
  form.addTextItem().setTitle('Имя').setRequired(true);
  form.addTextItem().setTitle('Группа или класс').setRequired(true);

  form.addPageBreakItem()
      .setTitle('Вопросы')
      .setHelpText('В каждом вопросе выберите один вариант ответа.');

  // ---------- вопросы ----------
  for (var i = 0; i < QUESTIONS.length; i++) {
    var item = QUESTIONS[i];
    var mc = form.addMultipleChoiceItem();

    mc.setTitle((i + 1) + '. ' + item.q);
    mc.setRequired(true);
    mc.setPoints(1);

    var choices = [];
    for (var j = 0; j < item.a.length; j++) {
      choices.push(mc.createChoice(item.a[j], j === item.ok));
    }
    mc.setChoices(choices);
  }

  Logger.log('ГОТОВО: ' + TITLE);
  Logger.log('Создано вопросов: ' + QUESTIONS.length);
  Logger.log('Ссылка для прохождения:   ' + form.getPublishedUrl());
  Logger.log('Ссылка на редактирование: ' + form.getEditUrl());
}
