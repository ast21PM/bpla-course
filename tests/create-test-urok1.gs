/**
 * Создание теста к уроку 1 «Что такое БПЛА»
 * Учебное пособие «Внутреннее устройство БПЛА»
 *
 * Как запустить:
 *   1. Нажать Run (кнопка «Выполнить») на функции createTestUrok1
 *   2. Один раз разрешить доступ к аккаунту
 *   3. Внизу откроется журнал выполнения со ссылками на готовую форму
 */

function createTestUrok1() {

  // ---------- вопросы: текст, варианты, номер правильного (с нуля) ----------
  var QUESTIONS = [
    {
      q: 'Что означает слово «беспилотный» в термине БПЛА?',
      a: ['Полётом никто не управляет',
          'На борту аппарата нет пилота',
          'Аппарат летает без двигателя',
          'Аппаратом управляет только компьютер'],
      ok: 1
    },
    {
      q: 'Что из перечисленного НЕ входит в состав беспилотной авиационной системы?',
      a: ['Летательный аппарат',
          'Пульт управления или наземная станция',
          'Канал радиосвязи',
          'Взлётно-посадочная полоса'],
      ok: 3
    },
    {
      q: 'Чем современный БПЛА принципиально отличается от простой радиоуправляемой авиамодели?',
      a: ['Он больше по размеру',
          'Между командами пилота и моторами работает электроника, которая сама удерживает аппарат в воздухе',
          'Он летает только по программе',
          'Он не использует радиосвязь'],
      ok: 1
    },
    {
      q: 'Как называется беспилотник с четырьмя винтами?',
      a: ['Гексакоптер', 'Октокоптер', 'Квадрокоптер', 'Конвертоплан'],
      ok: 2
    },
    {
      q: 'За счёт чего создаётся подъёмная сила у аппарата самолётного типа?',
      a: ['За счёт винтов, направленных вверх',
          'За счёт крыла при движении вперёд',
          'За счёт лёгкого газа внутри корпуса',
          'За счёт хвостового винта'],
      ok: 1
    },
    {
      q: 'Почему аппарат самолётного типа при той же батарее летает дольше мультикоптера?',
      a: ['У него мощнее мотор',
          'У него легче аккумулятор',
          'Его в воздухе держит крыло, а мотор нужен только для движения вперёд',
          'Он летит на меньшей высоте'],
      ok: 2
    },
    {
      q: 'Какой тип аппарата НЕ умеет неподвижно висеть в одной точке?',
      a: ['Мультикоптер', 'Самолётного типа', 'Вертолётного типа', 'Конвертоплан'],
      ok: 1
    },
    {
      q: 'Что такое конвертоплан?',
      a: ['Мультикоптер с восемью винтами',
          'Беспилотник, управляемый только по программе',
          'Аппарат с крылом и винтами вертикального взлёта, сочетающий свойства коптера и самолёта',
          'Аппарат, который запускается с катапульты'],
      ok: 2
    },
    {
      q: 'Сколько винтов у гексакоптера?',
      a: ['Четыре', 'Шесть', 'Восемь', 'Один большой и один хвостовой'],
      ok: 1
    },
    {
      q: 'Что такое FPV?',
      a: ['Отдельный тип беспилотника',
          'Способ управления, при котором пилот видит картинку с камеры дрона',
          'Название полётного контроллера',
          'Вид аккумулятора'],
      ok: 1
    },
    {
      q: 'Полёт выполняется по заранее заданным на карте точкам, оператор только наблюдает. Как называется такой уровень?',
      a: ['Дистанционное управление', 'Автоматический полёт', 'Визуальный полёт', 'Ручное управление'],
      ok: 1
    },
    {
      q: 'От чего в первую очередь зависит, нужно ли регистрировать аппарат и где на нём можно летать?',
      a: ['От числа винтов', 'От цвета корпуса', 'От взлётной массы аппарата', 'От марки камеры'],
      ok: 2
    },
    {
      q: 'Чем отличаются разведывательный и ударный беспилотники по назначению?',
      a: ['Разведывательный летает выше',
          'Разведывательный ведёт наблюдение и передаёт изображение, ударный несёт вооружение для поражения целей',
          'Разведывательный больше по размеру',
          'Между ними нет разницы'],
      ok: 1
    },
    {
      q: 'Два внешне одинаковых квадрокоптера называют съёмочным и инспекционным. Чем они отличаются?',
      a: ['Конструкцией рамы', 'Количеством винтов', 'Полезной нагрузкой на борту', 'Типом управления'],
      ok: 2
    },
    {
      q: 'Нужно составить точную карту поля площадью 400 гектаров за один выезд. Какой тип аппарата подойдёт лучше?',
      a: ['Мультикоптер, потому что он умеет висеть на месте',
          'Самолётного типа, потому что важны время полёта и дальность',
          'Вертолётного типа, потому что он несёт большой груз',
          'Нанодрон, потому что он компактный'],
      ok: 1
    }
  ];

  // ---------- создание формы ----------
  var form = FormApp.create('Тест к уроку 1 — Что такое БПЛА');

  form.setDescription(
    'Учебное пособие «Внутреннее устройство БПЛА».\n\n' +
    '15 вопросов, в каждом один правильный ответ. Максимум — 15 баллов, ' +
    'рекомендуемый результат — не менее 12.\n\n' +
    'Укажите фамилию, имя и группу: эти данные сохраняются вместе с ответами.'
  );

  form.setIsQuiz(true);
  form.setShowLinkToRespondAgain(true);
  form.setConfirmationMessage(
    'Ответы отправлены. Если остались ошибки, вернитесь к конспекту урока и пройдите тест ещё раз.'
  );

  // ---------- поля с данными учащегося ----------
  form.addTextItem().setTitle('Фамилия').setRequired(true);
  form.addTextItem().setTitle('Имя').setRequired(true);
  form.addTextItem().setTitle('Группа или класс').setRequired(true);

  form.addPageBreakItem()
      .setTitle('Вопросы')
      .setHelpText('В каждом вопросе выберите один вариант ответа.');

  // ---------- вопросы ----------
  for (var i = 0; i < QUESTIONS.length; i++) {
    var item = QUESTIONS[i];
    var mc = form.addMultipleChoiceItem();

    mc.setTitle((i + 1) + '. ' + item.q);
    mc.setRequired(true);
    mc.setPoints(1);

    var choices = [];
    for (var j = 0; j < item.a.length; j++) {
      choices.push(mc.createChoice(item.a[j], j === item.ok));
    }
    mc.setChoices(choices);
  }

  // ---------- результат ----------
  var urlForm = form.getPublishedUrl();
  var urlEdit = form.getEditUrl();

  Logger.log('ГОТОВО. Создано вопросов: ' + QUESTIONS.length);
  Logger.log('Ссылка для прохождения:  ' + urlForm);
  Logger.log('Ссылка на редактирование: ' + urlEdit);

  return { form: urlForm, edit: urlEdit };
}
